<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: 'Forgot password \u2014 Security Desk' }) %>
<body class="console">
  <div class="console-topbar">
    <a href="/" class="brand"><span class="brand__mark"><img src="/images/nsuk-logo.png" alt="NSUK crest" /></span> CampusGuard &middot; Security Desk</a>
    <div class="nav-links"><a class="btn btn-ghost btn-sm" href="/">Back to site</a></div>
  </div>
  <section class="auth-split full-bleed">
    <div class="auth-green">
      <div class="green-watermark"><img src="/images/nsuk-logo.png" alt="" /></div>
      <div class="brand__mark--lg"><img src="/images/nsuk-logo.png" alt="NSUK crest" /></div>
      <h2>Forgot your password?</h2>
      <p class="lead">We'll email your security desk account a link to set a new one.</p>
    </div>
    <div class="auth-white">
      <div class="auth-white__inner">
        <h1>Reset password</h1>
        <p class="subhead">Enter the email address on your security desk account.</p>

        <% if (error) { %>
          <div class="alert-box"><%= error %></div>
        <% } %>

        <% if (sent) { %>
          <div class="success-box">If a security desk account exists for <%= email %>, a password reset link has been sent. Check your inbox (and spam folder).</div>
          <div class="form-foot"><a href="/admin/login">Back to login</a></div>
        <% } else { %>
          <form action="/admin/forgot-password" method="POST">
            <div class="field">
              <label for="email">Email address</label>
              <input type="email" id="email" name="email" value="<%= email %>" required autofocus />
            </div>
            <button type="submit" class="btn btn-primary btn-block">Send reset link</button>
          </form>
          <div class="form-foot">Remembered it? <a href="/admin/login">Log in</a></div>
        <% } %>
      </div>
    </div>
  </section>
</body>
</html>
