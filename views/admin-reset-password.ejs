<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: 'Set new password \u2014 Security Desk' }) %>
<body class="console">
  <div class="console-topbar">
    <a href="/" class="brand"><span class="brand__mark"><img src="/images/nsuk-logo.png" alt="NSUK crest" /></span> CampusGuard &middot; Security Desk</a>
    <div class="nav-links"><a class="btn btn-ghost btn-sm" href="/">Back to site</a></div>
  </div>
  <section class="auth-split full-bleed">
    <div class="auth-green">
      <div class="green-watermark"><img src="/images/nsuk-logo.png" alt="" /></div>
      <div class="brand__mark--lg"><img src="/images/nsuk-logo.png" alt="NSUK crest" /></div>
      <h2>Set a new password</h2>
      <p class="lead">Choose a new password for your security desk account.</p>
    </div>
    <div class="auth-white">
      <div class="auth-white__inner">
        <h1>New password</h1>

        <% if (error) { %>
          <div class="alert-box"><%= error %></div>
        <% } %>

        <% if (token) { %>
          <form action="/admin/reset-password/<%= token %>" method="POST">
            <div class="field">
              <label for="password">New password</label>
              <input type="password" id="password" name="password" required minlength="6" autofocus />
            </div>
            <div class="field">
              <label for="confirm_password">Confirm new password</label>
              <input type="password" id="confirm_password" name="confirm_password" required minlength="6" />
            </div>
            <button type="submit" class="btn btn-primary btn-block">Set new password</button>
          </form>
        <% } else { %>
          <div class="form-foot"><a href="/admin/forgot-password">Request a new reset link</a></div>
        <% } %>
      </div>
    </div>
  </section>
</body>
</html>
