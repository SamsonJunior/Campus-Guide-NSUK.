<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: 'Forgot password' }) %>
<body>
  <%- include('partials/topbar') %>
  <section class="auth-split full-bleed">
    <div class="auth-green">
      <div class="green-watermark"><img src="/images/nsuk-logo.png" alt="" /></div>
      <div class="brand__mark--lg"><img src="/images/nsuk-logo.png" alt="NSUK crest" /></div>
      <h2>Forgot your password?</h2>
      <p class="lead">No problem &mdash; we'll email you a link to set a new one.</p>
    </div>
    <div class="auth-white">
      <div class="auth-white__inner">
        <h1>Reset password</h1>
        <p class="subhead">Enter the email address on your student account.</p>

        <% if (error) { %>
          <div class="alert-box"><%= error %></div>
        <% } %>

        <% if (sent) { %>
          <div class="success-box">If an account exists for <%= email %>, a password reset link has been sent. Check your inbox (and spam folder).</div>
          <div class="form-foot"><a href="/login">Back to login</a></div>
        <% } else { %>
          <form action="/forgot-password" method="POST">
            <div class="field">
              <label for="email">Email address</label>
              <input type="email" id="email" name="email" value="<%= email %>" required autofocus />
            </div>
            <button type="submit" class="btn btn-primary btn-block">Send reset link</button>
          </form>
          <div class="form-foot">Remembered it? <a href="/login">Log in</a></div>
        <% } %>
      </div>
    </div>
  </section>
  <%- include('partials/footer') %>
</body>
</html>
