<div class="topbar">
  <div class="topbar__inner">
    <a href="/" class="brand"><span class="brand__mark"><img src="/images/nsuk-logo.png" alt="NSUK crest" /></span> CampusGuard</a>
    <div class="nav-links">
      <% if (isStudentAuthed) { %>
        <a class="btn btn-ghost btn-sm" href="/dashboard">Dashboard</a>
        <form action="/logout" method="POST" style="display:inline">
          <button class="btn btn-primary btn-sm" type="submit">Log out</button>
        </form>
      <% } else { %>
        <a class="btn btn-ghost btn-sm" href="/login">Student login</a>
        <a class="btn btn-primary btn-sm" href="/register">Register</a>
      <% } %>
    </div>
  </div>
</div>
